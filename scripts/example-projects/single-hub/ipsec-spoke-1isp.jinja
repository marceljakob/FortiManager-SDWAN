config adom/template/_ipsec/ipsec-spoke-1isp
    
config vpn ipsec phase1-interface
    edit "H1_ISP1"
        set interface $(str_spoke_port_wan)
        set ike-version 2
        set keylife 28800
        set peertype any
        set net-device disable
        set proposal aes256gcm-prfsha256
        set dhgrp 20 21
        set link-cost 0
        set nattraversal enable
        set network-overlay enable
        set add-route disable
        set encapsulation none
        set network-id 11
        set transport udp
        set remote-gw $(pip1_hub1)
        set psksecret $(sec_psk_ipsec)
        set exchange-fgt-device-id enable
        set dpd-retrycount 3
        set dpd-retryinterval 5
        set dpd on-idle  
        set idle-timeout enable
        set shared-idle-timeout enable
        set auto-discovery-receiver enable
        set exchange-ip-addr4 $(ip_spoke_bgp_lo)
    next
end

config vpn ipsec phase2-interface
    edit "H1_ISP1"
        set phase1name "H1_ISP1"
        set proposal aes256gcm
        set dhgrp 20 21
        set keepalive enable
        set keylifeseconds 3600
    next
end

end
