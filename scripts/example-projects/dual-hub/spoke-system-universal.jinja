config adom/devprof/spoke-system-universal

  config system global
    set admintimeout 30
  end
  
 config system settings
  set location-id $(ip_spoke_bgp_lo)
  set allow-subnet-overlap enable
end

config system template interface
  edit 1
        set name "Lo-BGP"
        set action add-loopback
        set model "all"
        set vdom "root"
    next
    end
    
end
