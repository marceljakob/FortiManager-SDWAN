config cli template
    edit "spoke-cli-universal"
        set type cli
        set script "config system interface
    edit Lo-BGP
        set vdom root
        set type loopback
        set ip $(ip_spoke_bgp_lo) 255.255.255.255
        set allowaccess ping
    next
end config system settings
  set location-id $(ip_spoke_bgp_lo)
  set allow-subnet-overlap enable
  set tcp-session-without-syn enable
end"
    next
end
