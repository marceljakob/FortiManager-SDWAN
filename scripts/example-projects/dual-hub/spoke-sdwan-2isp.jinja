config adom/wanprof/spoke-sdwan-2isp

config system sdwan
    set status enable
    config zone
        edit "virtual-wan-link"
        next
        edit "underlay"
        next
        edit "overlay"
        next
    end
    
    config members
        edit 1
            set interface $(str_spoke_port_wan1)
            set zone "underlay"
        next
        edit 2
            set interface $(str_spoke_port_wan2)
            set zone "underlay"
        next
        edit 11
            set interface "H1_ISP11"
            set zone "overlay"
            set priority 10
        next
        edit 12
            set interface "H1_ISP12"
            set zone "overlay"
            set priority 10
        next
        edit 13
            set interface "H1_ISP21"
            set zone "overlay"
            set priority 10
        next
        edit 14
            set interface "H1_ISP22"
            set zone "overlay"
            set priority 10
        next
        edit 21
            set interface "H2_ISP11"
            set zone "overlay"
            set priority 10
        next
        edit 22
            set interface "H2_ISP12"
            set zone "overlay"
            set priority 10
        next
        edit 23
            set interface "H2_ISP21"
            set zone "overlay"
            set priority 10
        next
        edit 24
            set interface "H2_ISP22"
            set zone "overlay"
            set priority 10
        next
    end
    
    config health-check
        edit "HUB1"
            set server $(ip_hub1_hc_lo)
            set embed-measured-health enable
            set members 11 12 13 14
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold 100
                    set jitter-threshold 50
                    set packetloss-threshold 5
                next
            end
        next
        edit "HUB2"
            set server $(ip_hub_hc_lo)
            set embed-measured-health enable
            set members 21 22 23 24
            config sla
                edit 1
                    set link-cost-factor latency jitter packet-loss
                    set latency-threshold 100
                    set jitter-threshold 50
                    set packetloss-threshold 5
                next
            end
        next
    end

      config neighbor
        edit $(ip_hub1_bgp_lo)
            set member 11 12 13 14
            set route-metric priority
            set health-check "HUB1"
        next
          edit $(ip_hub2_bgp_lo)
            set member 21 22 23 24
            set route-metric priority
            set health-check "HUB1"
        next
    end

    
    config service
        edit 1
            set name "H1-CORPORATE"
            set mode sla
            set dst "all"
            set src "all"
            config sla
                edit "HUB1"
                    set id 1
                next
            end
            set priority-members 11 12 14 14
            set tie-break fib-best-match
        next
        edit 2
            set name "H2-CORPORATE"
            set mode sla
            set dst "all"
            set src "all"
            config sla
                edit "HUB2"
                    set id 2
                next
            end
            set priority-members 21 22 23 24
            set tie-break fib-best-match
        next
    end

end


end
